{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "RoleSource": "IdentityService"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/categories/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/products/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "inventory-stock": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/stock/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "billing-invoices": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/v1/invoices/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "billing-customers": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/v1/customers/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "billing-delivery-schedules": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/v1/delivery-schedules/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Staff"
      },
      "identity-api": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" },
        "AuthorizationPolicy": "HappyBoxx.Authenticated"
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "default": { "Address": "https+http://catalog-api" }
        }
      },
      "inventory": {
        "Destinations": {
          "default": { "Address": "https+http://inventory-api" }
        }
      },
      "billing": {
        "Destinations": {
          "default": { "Address": "https+http://billing-api" }
        }
      },
      "identity": {
        "Destinations": {
          "default": { "Address": "https+http://identity-api" }
        }
      }
    }
  }
}
