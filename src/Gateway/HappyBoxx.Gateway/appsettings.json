{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/categories/{**catch-all}" }
      },
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "inventory-stock": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/stock/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "default": { "Address": "https+http://catalog-api" }
        }
      },
      "inventory": {
        "Destinations": {
          "default": { "Address": "https+http://inventory-api" }
        }
      }
    }
  }
}
