VITE_AUTH_MODE=development

# For a real Entra External ID test tenant, change VITE_AUTH_MODE to entra and set:
# VITE_ENTRA_CLIENT_ID=<spa-application-client-id>
# VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/
# VITE_ENTRA_API_SCOPE=api://<api-application-id>/access_as_user
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173/

# Vite variables are included in browser assets. Never put client secrets here.