<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>HappyBoxx</Company>
    <Product>HappyBoxx</Product>
  </PropertyGroup>

  <!-- Opt-in for machines whose policy blocks unsigned .exe files: set env HAPPYBOXX_NO_APPHOST=true (xUnit v3 test projects always need an app host). -->
  <PropertyGroup Condition="'$(HAPPYBOXX_NO_APPHOST)' == 'true' and !$(MSBuildProjectName.EndsWith('Tests'))">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
